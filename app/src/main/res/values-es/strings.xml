    <!-- Device Admin (App Uninstall Protection) -->
    <string name="device_admin_title">Protección contra eliminación de la app</string>
    <string name="device_admin_desc">Prevenir desinstalación impulsiva de la app</string>
    <string name="device_admin_explanation">¿Alguna vez has eliminado la app en un momento de debilidad?\n\nun:short previene la desinstalación impulsiva cuando tu determinación flaquea.</string>
    <string name="device_admin_dialog_title">¿Activar protección contra eliminación?</string>
    <string name="device_admin_dialog_message">Esta función añade un paso adicional antes de desinstalar un:short.\n\nTe ayuda a resistir decisiones impulsivas en momentos de debilidad.\n\nPuedes desactivar esto en cualquier momento en Configuración → Seguridad → Apps de administración del dispositivo.</string>
    <string name="device_admin_dialog_enable">Activar</string>
    <string name="device_admin_dialog_cancel">Ahora no</string>
    <string name="device_admin_deactivate_title">¿Desactivar protección?</string>
    <string name="device_admin_deactivate_message">Para desactivar esta función, ve a:\n\nConfiguración → Seguridad → Apps de administración del dispositivo → un:short\n\nLuego toca [Desactivar]</string>
    <string name="device_admin_deactivate_button">Ir a configuración</string>
    <string name="device_admin_receiver_enabled">Protección contra eliminación de la app un:short activada</string>
    <string name="device_admin_receiver_disable_warning">Desactivar la protección contra eliminación permite la desinstalación impulsiva de un:short. ¿Continuar?</string>
