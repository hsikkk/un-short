    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">Lo que accedemos</string>

    <string name="privacy_why_title">¿Por qué se necesita el permiso de accesibilidad?</string>
    <string name="privacy_why_content">un:short usa el servicio de accesibilidad para detectar contenido de video corto.\n\nEsta es la función principal para bloquear automáticamente shorts cuando se detectan.</string>

    <string name="privacy_data_title">Datos que recopilamos</string>
    <string name="privacy_data_collected">✓ Contenido de la pantalla (solo para detección de shorts)\n✓ Nombres de paquetes de apps\n✓ Hash de metadatos de video (temporal)</string>
    <string name="privacy_data_not_collected">✗ Información personal (nombre, contactos, etc.)\n✗ Historial de visualización\n✗ Información de cuenta\n✗ Entrada de texto</string>

    <string name="privacy_usage_title">Cómo se usan los datos</string>
    <string name="privacy_usage_content">• Usado solo para detección de pantalla de shorts\n• Sin transmisión al servidor (100% sin conexión)\n• Solo hashes temporales para detección de cambios de video\n• Eliminación automática al cerrar la app</string>

    <string name="privacy_storage_title">Política de almacenamiento de datos</string>
    <string name="privacy_storage_content">• Solo IDs de sesión almacenados temporalmente en el dispositivo\n• Eliminados inmediatamente al reiniciar app/servicio\n• Nunca compartidos con terceros</string>

    <string name="privacy_faq_title">Preguntas frecuentes</string>
    <string name="privacy_faq_content">P: ¿Se guarda mi historial de visualización?\nR: No. Solo se almacenan valores hash temporalmente.\n\nP: ¿Comparten datos con terceros?\nR: No. Operación completamente sin conexión.\n\nP: ¿Puedo revocar el permiso más tarde?\nR: Sí. Puedes desactivarlo en configuración en cualquier momento.</string>

    <string name="privacy_btn_agree">Aceptar &amp; Ir a configuración</string>
    <string name="privacy_btn_exit">Salir de la app</string>
    <string name="privacy_btn_disagree">No aceptar</string>

