    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">Ce à quoi nous accédons</string>

    <string name="privacy_why_title">Pourquoi l\'autorisation d\'accessibilité est-elle nécessaire ?</string>
    <string name="privacy_why_content">un:short utilise le service d\'accessibilité pour détecter le contenu vidéo court.\n\nC\'est la fonction principale pour bloquer automatiquement les shorts lorsqu\'ils sont détectés.</string>

    <string name="privacy_data_title">Données que nous collectons</string>
    <string name="privacy_data_collected">✓ Contenu de l\'écran (uniquement pour la détection de shorts)\n✓ Noms de paquets d\'applications\n✓ Hash de métadonnées vidéo (temporaire)</string>
    <string name="privacy_data_not_collected">✗ Informations personnelles (nom, contacts, etc.)\n✗ Historique de visionnage\n✗ Informations de compte\n✗ Saisie de texte</string>

    <string name="privacy_usage_title">Comment les données sont utilisées</string>
    <string name="privacy_usage_content">• Utilisé uniquement pour la détection d\'écran de shorts\n• Aucune transmission au serveur (100 % hors ligne)\n• Seulement des hashs temporaires pour la détection de changement de vidéo\n• Suppression automatique à la fermeture de l\'application</string>

    <string name="privacy_storage_title">Politique de stockage des données</string>
    <string name="privacy_storage_content">• Seuls les ID de session stockés temporairement sur l\'appareil\n• Supprimés immédiatement au redémarrage de l\'application/service\n• Jamais partagés avec des tiers</string>

    <string name="privacy_faq_title">Questions fréquemment posées</string>
    <string name="privacy_faq_content">Q : Mon historique de visionnage est-il enregistré ?\nR : Non. Seules les valeurs de hash sont stockées temporairement.\n\nQ : Partagez-vous des données avec des tiers ?\nR : Non. Fonctionnement complètement hors ligne.\n\nQ : Puis-je révoquer l\'autorisation plus tard ?\nR : Oui. Vous pouvez la désactiver dans les paramètres à tout moment.</string>

    <string name="privacy_btn_agree">Accepter &amp; Aller aux paramètres</string>
    <string name="privacy_btn_exit">Quitter l\'application</string>
    <string name="privacy_btn_disagree">Refuser</string>

