    <!-- Device Admin (App Uninstall Protection) -->
    <string name="device_admin_title">App Deletion Protection</string>
    <string name="device_admin_desc">Prevent impulsive app uninstallation</string>
    <string name="device_admin_explanation">Ever deleted the app in a moment of weakness?\n\nun:short prevents impulsive uninstallation when your resolve wavers.</string>
    <string name="device_admin_dialog_title">Enable Deletion Protection?</string>
    <string name="device_admin_dialog_message">This feature adds an extra step before uninstalling un:short.\n\nIt helps you resist impulsive decisions during moments of weakness.\n\nYou can deactivate this anytime in Settings → Security → Device admin apps.</string>
    <string name="device_admin_dialog_enable">Enable</string>
    <string name="device_admin_dialog_cancel">Not now</string>
    <string name="device_admin_deactivate_title">Deactivate Protection?</string>
    <string name="device_admin_deactivate_message">To disable this feature, go to:\n\nSettings → Security → Device admin apps → un:short\n\nThen tap [Deactivate]</string>
    <string name="device_admin_deactivate_button">Go to Settings</string>
    <string name="device_admin_receiver_enabled">un:short app deletion protection enabled</string>
    <string name="device_admin_receiver_disable_warning">Disabling deletion protection allows impulsive uninstallation of un:short. Continue?</string>
