    <!-- Device Admin (App Uninstall Protection) -->
    <string name="device_admin_title">App Deletion Protection</string>
    <string name="device_admin_desc">Prevent impulsive app uninstallation</string>
    <string name="device_admin_explanation">Ever deleted the app in a moment of weakness?\n\nun:short prevents impulsive uninstallation when your resolve wavers.</string>
    <string name="device_admin_dialog_title">Enable Deletion Protection?</string>
    <string name="device_admin_dialog_message">This feature adds an extra step before uninstalling un:short.\n\nIt helps you resist impulsive decisions during moments of weakness.\n\nYou can deactivate this anytime in Settings → Security → Device admin apps.</string>
    <string name="device_admin_dialog_enable">Enable</string>
    <string name="device_admin_dialog_cancel">Not now</string>
    <string name="device_admin_deactivate_title">Deactivate Protection?</string>
    <string name="device_admin_deactivate_message">To disable this feature, go to:\n\nSettings → Security → Device admin apps → un:short\n\nThen tap [Deactivate]</string>
    <string name="device_admin_deactivate_button">Go to Settings</string>
    <string name="device_admin_receiver_enabled">un:short app deletion protection enabled</string>
    <string name="device_admin_receiver_disable_warning">Disabling deletion protection allows impulsive uninstallation of un:short. Continue?</string>
    <string name="device_admin_receiver_disabled">un:short app deletion protection disabled</string>

    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">What We Access</string>

    <string name="privacy_why_title">Why is accessibility permission needed?</string>
    <string name="privacy_why_content">un:short uses accessibility service to detect short-form video content.\n\nThis is the core function to automatically block shorts when detected.</string>

    <string name="privacy_data_title">Data We Collect</string>
    <string name="privacy_data_collected">✓ Screen content (for shorts detection only)\n✓ App package names\n✓ Video metadata hash (temporary)</string>
    <string name="privacy_data_not_collected">✗ Personal information (name, contacts, etc.)\n✗ Watch history\n✗ Account information\n✗ Text input</string>

    <string name="privacy_usage_title">How Data is Used</string>
    <string name="privacy_usage_content">• Used only for shorts screen detection\n• No server transmission (100% offline)\n• Only temporary hashes for video change detection\n• Auto-deleted when app closes</string>

    <string name="privacy_storage_title">Data Storage Policy</string>
    <string name="privacy_storage_content">• Only session IDs stored temporarily on device\n• Immediately deleted when app/service restarts\n• Never shared with third parties</string>

    <string name="privacy_faq_title">Frequently Asked Questions</string>
    <string name="privacy_faq_content">Q: Is my watch history saved?\nA: No. Only hash values are temporarily stored.\n\nQ: Do you share data with third parties?\nA: No. Completely offline operation.\n\nQ: Can I revoke permission later?\nA: Yes. You can disable it in settings anytime.</string>

