<?xml version="1.0" encoding="utf-8"?>
<defaultsMap>
    <!-- Firebase Remote Config 기본값 -->
    <!-- 쇼츠·피드 차단 화면 광고: 정책 검토 중 기본 비활성화 -->
    <entry>
        <key>overlay_native_ad_enabled</key>
        <value>false</value>
    </entry>
    <entry>
        <key>overlay_banner_ad_enabled</key>
        <value>false</value>
    </entry>

    <!-- 일일 즉시 해제 한도 (무조건 10회) -->
    <entry>
        <key>unblock_quota_daily_limit</key>
        <value>10</value>
    </entry>

    <!-- 광고 1편 시청 시 한도 충전량 (기본 +3회) -->
    <entry>
        <key>unblock_quota_ad_recharge_amount</key>
        <value>3</value>
    </entry>
</defaultsMap>
