    <!-- Device Admin (App Uninstall Protection) -->
    <string name="device_admin_title">Bảo vệ xóa ứng dụng</string>
    <string name="device_admin_desc">Ngăn gỡ cài đặt ứng dụng bốc đồng</string>
    <string name="device_admin_explanation">Đã từng xóa ứng dụng trong giây phút yếu đuối?\n\nun:short ngăn bạn gỡ cài đặt bốc đồng khi quyết tâm lung lay.</string>
    <string name="device_admin_dialog_title">Bật bảo vệ xóa?</string>
    <string name="device_admin_dialog_message">Tính năng này thêm bước bổ sung trước khi gỡ cài đặt un:short.\n\nNó giúp bạn chống lại quyết định bốc đồng trong những khoảnh khắc yếu đuối.\n\nBạn có thể tắt tính năng này bất kỳ lúc nào trong Cài đặt → Bảo mật → Ứng dụng quản trị thiết bị.</string>
    <string name="device_admin_dialog_enable">Bật</string>
    <string name="device_admin_dialog_cancel">Không phải bây giờ</string>
    <string name="device_admin_deactivate_title">Tắt bảo vệ?</string>
    <string name="device_admin_deactivate_message">Để tắt tính năng này, hãy đi đến:\n\nCài đặt → Bảo mật → Ứng dụng quản trị thiết bị → un:short\n\nSau đó nhấn [Tắt]</string>
    <string name="device_admin_deactivate_button">Đi đến cài đặt</string>
    <string name="device_admin_receiver_enabled">Bảo vệ xóa ứng dụng un:short đã bật</string>
    <string name="device_admin_receiver_disable_warning">Tắt bảo vệ xóa cho phép gỡ cài đặt bốc đồng un:short. Tiếp tục?</string>
    <string name="device_admin_receiver_disabled">Bảo vệ xóa ứng dụng un:short đã tắt</string>

    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">Chúng tôi truy cập gì</string>

    <string name="privacy_why_title">Tại sao cần quyền truy cập?</string>
    <string name="privacy_why_content">un:short sử dụng dịch vụ truy cập để phát hiện nội dung video ngắn.\n\nĐây là chức năng cốt lõi để tự động chặn shorts khi phát hiện.</string>

    <string name="privacy_data_title">Dữ liệu chúng tôi thu thập</string>
    <string name="privacy_data_collected">✓ Nội dung màn hình (chỉ để phát hiện shorts)\n✓ Tên gói ứng dụng\n✓ Hash siêu dữ liệu video (tạm thời)</string>
    <string name="privacy_data_not_collected">✗ Thông tin cá nhân (tên, liên hệ, v.v.)\n✗ Lịch sử xem\n✗ Thông tin tài khoản\n✗ Nhập văn bản</string>

    <string name="privacy_usage_title">Cách sử dụng dữ liệu</string>
    <string name="privacy_usage_content">• Chỉ dùng để phát hiện màn hình shorts\n• Không truyền đến máy chủ (100% ngoại tuyến)\n• Chỉ hash tạm thời để phát hiện thay đổi video\n• Tự động xóa khi đóng ứng dụng</string>

    <string name="privacy_storage_title">Chính sách lưu trữ dữ liệu</string>
    <string name="privacy_storage_content">• Chỉ lưu trữ ID phiên tạm thời trên thiết bị\n• Xóa ngay lập tức khi khởi động lại ứng dụng/dịch vụ\n• Không bao giờ chia sẻ với bên thứ ba</string>

    <string name="privacy_faq_title">Câu hỏi thường gặp</string>
    <string name="privacy_faq_content">H: Lịch sử xem có được lưu không?\nĐ: Không. Chỉ giá trị hash được lưu tạm thời.\n\nH: Có chia sẻ dữ liệu với bên thứ ba không?\nĐ: Không. Hoàn toàn hoạt động ngoại tuyến.\n\nH: Tôi có thể thu hồi quyền sau không?\nĐ: Có. Bạn có thể tắt bất kỳ lúc nào trong cài đặt.</string>

    <string name="privacy_btn_agree">Đồng ý &amp; Đi đến cài đặt</string>
    <string name="privacy_btn_exit">Thoát ứng dụng</string>
    <string name="privacy_btn_disagree">Không đồng ý</string>

