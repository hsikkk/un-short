<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            android:alpha="0.7"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:contentDescription="@string/permission_back_button" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/report_title"
            android:textSize="16sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:textColor="@color/gray_900" />
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"
        android:alpha="0.1" />

    <!-- Content ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Daily Trend Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <!-- Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_daily_trend"
                    android:textSize="13sp"
                    android:fontFamily="@font/spoqa_sans_neo_medium"
                    android:textColor="@color/gray_900"
                    android:alpha="0.5"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp" />

                <!-- Metric Tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/tab_container_background"
                    android:padding="4dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/tabAttempts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/report_attempts"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_900"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/tab_selected_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabWatched"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/report_watched"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_600"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/tab_unselected_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabWatchTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/report_watch_time"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_600"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/tab_unselected_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Chart View -->
                <com.muuu.unshort.ui.report.BarChartView
                    android:id="@+id/chartView"
                    android:layout_width="match_parent"
                    android:layout_height="260dp" />
            </LinearLayout>

            <!-- Summary Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <!-- Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_summary"
                    android:textSize="13sp"
                    android:fontFamily="@font/spoqa_sans_neo_medium"
                    android:textColor="@color/gray_900"
                    android:alpha="0.5"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp" />

                <!-- Summary Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Attempts Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/report_attempts"
                            android:textSize="13sp"
                            android:fontFamily="@font/spoqa_sans_neo_regular"
                            android:textColor="@color/gray_600"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/summaryAttemptValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:fontFamily="@font/spoqa_sans_neo_bold"
                            android:textColor="@color/gray_900" />
                    </LinearLayout>

                    <!-- Divider 1 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="48dp"
                        android:background="@android:color/black"
                        android:alpha="0.1" />

                    <!-- Watched Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/report_watched"
                            android:textSize="13sp"
                            android:fontFamily="@font/spoqa_sans_neo_regular"
                            android:textColor="@color/gray_600"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/summaryWatchedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:fontFamily="@font/spoqa_sans_neo_bold"
                            android:textColor="@color/gray_900" />
                    </LinearLayout>

                    <!-- Divider 2 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="48dp"
                        android:background="@android:color/black"
                        android:alpha="0.1" />

                    <!-- Watch Time Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/report_watch_time"
                            android:textSize="13sp"
                            android:fontFamily="@font/spoqa_sans_neo_regular"
                            android:textColor="@color/gray_600"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/summaryTimeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0분"
                            android:textSize="32sp"
                            android:fontFamily="@font/spoqa_sans_neo_bold"
                            android:textColor="@color/gray_900" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Detail Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_detail"
                    android:textSize="13sp"
                    android:fontFamily="@font/spoqa_sans_neo_medium"
                    android:textColor="@color/gray_900"
                    android:alpha="0.5"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp" />

                <!-- Empty State (initially hidden) -->
                <include
                    android:id="@+id/emptyStateView"
                    layout="@layout/empty_state_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- App List Container -->
                <LinearLayout
                    android:id="@+id/appListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
