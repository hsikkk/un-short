<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Header -->
    <include layout="@layout/common_header" />

    <!-- Sticky Date Chips (초기 숨김) -->
    <LinearLayout
        android:id="@+id/stickyDateChipsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- Sticky Date Chips -->
        <LinearLayout
            android:id="@+id/stickyDateChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"
        android:alpha="0.1" />

    <!-- Content ScrollView -->
    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Daily Trend Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">
                
                <!-- Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_daily_trend"
                    android:textSize="16sp"
                    android:fontFamily="@font/spoqa_sans_neo_bold"
                    android:textColor="@color/gray_900"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="20dp" />

                <!-- Metric Tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/tab_container_background"
                    android:padding="4dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/tabAttempts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stats_entry_count"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_900"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/tab_selected_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabWatched"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stats_consumption_count"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_600"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/tab_unselected_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabWatchTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stats_watch_time"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_600"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/tab_unselected_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Chart ViewPager -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/chartViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />
            </LinearLayout>

            <!-- MREC Ad Container -->
            <FrameLayout
                android:id="@+id/adViewReport"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="36dp"
                android:gravity="center" />

            <!-- Daily Analysis Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Top Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_300"
                    android:layout_marginBottom="20dp" />

                <!-- Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_daily_analysis"
                    android:textSize="16sp"
                    android:fontFamily="@font/spoqa_sans_neo_bold"
                    android:textColor="@color/gray_900"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="20dp" />

                <!-- Date Chips -->
                <LinearLayout
                    android:id="@+id/dateChipsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="20dp" />

                <!-- Summary Subsection Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_summary"
                    android:textSize="13sp"
                    android:fontFamily="@font/spoqa_sans_neo_medium"
                    android:textColor="@color/gray_900"
                    android:alpha="0.5"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Summary Grid -->
                <include layout="@layout/stats_summary_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp" />

                <!-- App Analysis -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <!-- Subsection Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_app_analysis"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_900"
                        android:alpha="0.5"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp" />

                    <!-- Empty State (initially hidden) -->
                    <include
                        android:id="@+id/emptyStateView"
                        layout="@layout/empty_state_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- App List Container -->
                    <LinearLayout
                        android:id="@+id/appListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Hourly Analysis -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Subsection Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_hourly_analysis"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_900"
                        android:alpha="0.5"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp" />

                    <!-- Metric Tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/tab_container_background"
                    android:padding="4dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/hourlyTabAttempts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stats_entry_count"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_900"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/tab_selected_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/hourlyTabWatched"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stats_consumption_count"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_600"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/tab_unselected_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/hourlyTabWatchTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stats_watch_time"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_medium"
                        android:textColor="@color/gray_600"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/tab_unselected_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                    <!-- Hourly Chart ViewPager -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/hourlyChartViewPager"
                        android:layout_width="match_parent"
                        android:layout_height="608dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
