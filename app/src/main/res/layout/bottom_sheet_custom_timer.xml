<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 제목 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/custom_timer_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/spoqa_sans_neo_bold"
        android:textColor="@color/gray_900"
        android:layout_marginBottom="24dp" />

    <!-- 현재 값 표시 -->
    <TextView
        android:id="@+id/timerValueText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="30초"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="@font/spoqa_sans_neo_bold"
        android:textColor="@color/accent_purple"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- SeekBar -->
    <SeekBar
        android:id="@+id/timerSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="295"
        android:progress="25"
        android:progressTint="@color/accent_purple"
        android:thumbTint="@color/accent_purple"
        android:layout_marginBottom="16dp" />

    <!-- 범위 표시 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5초"
            android:textSize="13sp"
            android:fontFamily="@font/spoqa_sans_neo_regular"
            android:textColor="@color/gray_500"
            android:gravity="start" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="300초"
            android:textSize="13sp"
            android:fontFamily="@font/spoqa_sans_neo_regular"
            android:textColor="@color/gray_500"
            android:gravity="end" />
    </LinearLayout>

    <!-- 프리셋 버튼 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/custom_timer_presets"
        android:textSize="14sp"
        android:fontFamily="@font/spoqa_sans_neo_medium"
        android:textColor="@color/gray_700"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/preset15"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="15초"
            android:textSize="14sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            app:strokeColor="@color/gray_300"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/preset30"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="30초"
            android:textSize="14sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            app:strokeColor="@color/gray_300"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/preset60"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="60초"
            android:textSize="14sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            app:strokeColor="@color/gray_300"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- 완료 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/doneButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/custom_timer_done"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/spoqa_sans_neo_bold"
        app:backgroundTint="@color/accent_purple"
        android:textColor="@color/white" />

</LinearLayout>
