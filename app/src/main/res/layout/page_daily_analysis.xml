<?xml version="1.0" encoding="utf-8"?>
<!-- Daily Analysis Page - 날짜별 페이지 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

        <!-- Summary Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_summary"
            android:textSize="13sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:textColor="@color/gray_900"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <include layout="@layout/stats_summary_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- App Analysis Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_app_analysis"
            android:textSize="13sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:textColor="@color/gray_900"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp" />

        <include
            android:id="@+id/emptyStateView"
            layout="@layout/empty_state_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/appListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- Hourly Analysis Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_hourly_analysis"
            android:textSize="13sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:textColor="@color/gray_900"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp" />

        <!-- Hourly Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/tab_container_background"
            android:padding="4dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/hourlyTabAttempts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stats_entry_count"
                android:textSize="13sp"
                android:fontFamily="@font/spoqa_sans_neo_medium"
                android:textColor="@color/gray_900"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/tab_selected_background"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/hourlyTabWatched"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stats_consumption_count"
                android:textSize="13sp"
                android:fontFamily="@font/spoqa_sans_neo_medium"
                android:textColor="@color/gray_600"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/tab_unselected_background"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/hourlyTabWatchTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stats_watch_time"
                android:textSize="13sp"
                android:fontFamily="@font/spoqa_sans_neo_medium"
                android:textColor="@color/gray_600"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/tab_unselected_background"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/hourlyChartViewPager"
            android:layout_width="match_parent"
            android:layout_height="608dp" />
</LinearLayout>
