<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/taskVerificationClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="×"
        android:textColor="#222222"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/spoqa_sans_neo_medium"
        android:text="@string/task_verification_heading"
        android:textColor="#111111"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/taskVerificationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/spoqa_sans_neo_regular"
        android:textColor="#555555"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/taskVerificationPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1"
        android:background="#F3F3F3"
        android:contentDescription="@string/task_verification_photo_description"
        android:scaleType="centerCrop"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/taskVerificationProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/taskVerificationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:minHeight="48dp"
        android:textColor="#555555"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/taskVerificationRetry"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/task_verification_retry" />

        <Button
            android:id="@+id/taskVerificationComplete"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/task_verification_complete" />
    </LinearLayout>
</LinearLayout>
