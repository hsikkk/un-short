<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <FrameLayout
      android:id="@+id/header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/white">

        <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="16dp">

            <!-- Back Button -->
            <ImageView
              android:id="@+id/backButton"
              android:layout_width="32dp"
              android:layout_height="32dp"
              android:layout_alignParentStart="true"
              android:layout_centerVertical="true"
              android:src="@drawable/ic_back"
              android:tint="@color/gray_900"
              android:alpha="0.7"
              android:clickable="true"
              android:focusable="true"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:padding="4dp"
              android:contentDescription="@string/permission_back_button"/>

            <!-- Title -->
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_centerInParent="true"
              android:text="@string/settings_title"
              android:textSize="16sp"
              android:fontFamily="@font/spoqa_sans_neo_medium"
              android:textColor="@color/gray_900"/>
        
        </RelativeLayout>
    
    
    </FrameLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        android:alpha="0.1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 프리미엄 배너 (무료 사용자만 표시) -->
            <LinearLayout
                android:id="@+id/premiumBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_premium_banner"
                android:layout_margin="16dp"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_banner_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/spoqa_sans_neo_bold"
                        android:textColor="@color/gray_900" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_banner_subtitle"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo"
                        android:textColor="@color/gray_600"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/premiumBannerButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/premium_banner_button"
                    android:textSize="13sp"
                    android:fontFamily="@font/spoqa_sans_neo_bold"
                    app:backgroundTint="@color/primary_dark"
                    android:textColor="@color/white"
                    android:paddingHorizontal="16dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />
            </LinearLayout>

            <!-- Section: 차단 옵션 관리 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_blocking"
                android:textSize="@dimen/text_caption"
                android:textColor="#000000"
                android:alpha="0.5"
                android:fontFamily="@font/spoqa_sans_neo"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="12dp"
                android:letterSpacing="0.02" />

            <!-- 대기 시간 관리 -->
            <LinearLayout
                android:id="@+id/waitTimeItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_delay_time_title"
                        android:textSize="@dimen/text_body"
                        android:textColor="#000000"
                        android:fontFamily="@font/spoqa_sans_neo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_delay_time_desc"
                        android:textSize="@dimen/text_caption"
                        android:textColor="#000000"
                        android:alpha="0.5"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/waitTimeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30초"
                    android:textSize="@dimen/text_caption"
                    android:textColor="#000000"
                    android:alpha="0.6"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/waitTimeProBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/spoqa_sans_neo_bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_pro_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 햅틱 피드백 -->
            <LinearLayout
                android:id="@+id/hapticItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_haptic_title"
                        android:textSize="@dimen/text_body"
                        android:textColor="#000000"
                        android:fontFamily="@font/spoqa_sans_neo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_haptic_desc"
                        android:textSize="@dimen/text_caption"
                        android:textColor="#000000"
                        android:alpha="0.5"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/hapticSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

            <!-- 스크롤한 쇼츠만 차단 -->
            <LinearLayout
                android:id="@+id/allowFirstItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_block_scrolled_title"
                        android:textSize="@dimen/text_body"
                        android:textColor="#000000"
                        android:fontFamily="@font/spoqa_sans_neo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_block_scrolled_desc"
                        android:textSize="@dimen/text_caption"
                        android:textColor="#000000"
                        android:alpha="0.5"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/allowFirstSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

                <TextView
                    android:id="@+id/allowFirstProBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/spoqa_sans_neo_bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_pro_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#000000"
                android:alpha="0.05" />

            <!-- Section: 보호 기능 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_protection"
                android:textSize="@dimen/text_caption"
                android:textColor="#000000"
                android:alpha="0.5"
                android:fontFamily="@font/spoqa_sans_neo"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="12dp"
                android:letterSpacing="0.02" />

            <!-- 충동적 차단 비활성화 방지 -->
            <LinearLayout
                android:id="@+id/preventDisableItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_prevent_disable_title"
                        android:textSize="@dimen/text_body"
                        android:textColor="#000000"
                        android:fontFamily="@font/spoqa_sans_neo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_prevent_disable_desc"
                        android:textSize="@dimen/text_caption"
                        android:textColor="#000000"
                        android:alpha="0.5"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/preventDisableSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

                <TextView
                    android:id="@+id/preventDisableProBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/spoqa_sans_neo_bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_pro_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 앱 삭제 방지 -->
            <LinearLayout
                android:id="@+id/deviceAdminItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_admin_title"
                        android:textSize="@dimen/text_body"
                        android:textColor="#000000"
                        android:fontFamily="@font/spoqa_sans_neo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_admin_desc"
                        android:textSize="@dimen/text_caption"
                        android:textColor="#000000"
                        android:alpha="0.5"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/deviceAdminSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

                <TextView
                    android:id="@+id/deviceAdminProBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/spoqa_sans_neo_bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_pro_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#000000"
                android:alpha="0.05" />

            <!-- Section: 기타 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_other"
                android:textSize="@dimen/text_caption"
                android:textColor="#000000"
                android:alpha="0.5"
                android:fontFamily="@font/spoqa_sans_neo"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="12dp"
                android:letterSpacing="0.02" />

            <!-- 피드백 보내기 -->
            <LinearLayout
                android:id="@+id/feedbackItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_feedback"
                    android:textSize="@dimen/text_body"
                    android:textColor="#000000"
                    android:fontFamily="@font/spoqa_sans_neo" />

            </LinearLayout>

            <!-- 앱 공유하기 -->
            <LinearLayout
                android:id="@+id/shareItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_share"
                    android:textSize="@dimen/text_body"
                    android:textColor="#000000"
                    android:fontFamily="@font/spoqa_sans_neo" />

            </LinearLayout>

            <!-- 리뷰 남기기 -->
            <LinearLayout
                android:id="@+id/reviewItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_review"
                    android:textSize="@dimen/text_body"
                    android:textColor="#000000"
                    android:fontFamily="@font/spoqa_sans_neo" />

            </LinearLayout>

            <!-- 버전 정보 -->
            <LinearLayout
                android:id="@+id/versionItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_version"
                    android:textSize="@dimen/text_body"
                    android:textColor="#000000"
                    android:fontFamily="@font/spoqa_sans_neo" />

                <TextView
                    android:id="@+id/versionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_version_default"
                    android:textSize="@dimen/text_caption"
                    android:textColor="#000000"
                    android:alpha="0.5" />

            </LinearLayout>

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
