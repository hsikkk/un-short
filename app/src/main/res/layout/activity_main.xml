<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Section - Black Background -->
    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header with Settings Icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Header Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:paddingTop="16dp">

            <!-- App Name with Premium Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="@dimen/text_logo"
                    android:fontFamily="@font/spoqa_sans_neo_thin"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="-0.02" />

                <!-- Premium Badge -->
                <TextView
                    android:id="@+id/premiumBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_marginTop="3dp"
                    android:text="PRO"
                    android:textSize="10sp"
                    android:fontFamily="@font/spoqa_sans_neo_medium"
                    android:textColor="#BDBDBD"
                    android:background="@drawable/premium_badge_background"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:letterSpacing="0.05"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_subtitle"
                android:textSize="@dimen/text_caption"
                android:fontFamily="@font/spoqa_sans_neo_thin"
                android:textColor="#FFFFFF"
                android:alpha="0.5"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- Stats Icon -->
            <ImageView
                android:id="@+id/statsButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="64dp"
                android:src="@drawable/ic_stats"
                android:tint="#FFFFFF"
                android:alpha="0.7"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="@string/stats_button" />

            <!-- Settings Icon with Badge -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp">

                <ImageView
                    android:id="@+id/settingsButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_settings"
                    android:tint="#FFFFFF"
                    android:alpha="0.7"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp" />

                <!-- Red Badge -->
                <View
                    android:id="@+id/settingsBadge"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/badge_red_dot"
                    android:visibility="invisible" />

            </FrameLayout>

        </RelativeLayout>

    </LinearLayout>

    <!-- Middle Section - White Background -->
    <LinearLayout
        android:id="@+id/middleSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topSection"
        app:layout_constraintBottom_toTopOf="@id/adViewContainer">

        <!-- Toggle Content Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6"
            android:orientation="vertical"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

        <!-- Toggle Area (shown when permissions granted) -->
        <LinearLayout
            android:id="@+id/toggleArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="8dp">

            <!-- Toggle Switch Container -->
            <FrameLayout
                android:id="@+id/toggleContainer"
                android:layout_width="180dp"
                android:layout_height="90dp"
                android:background="@drawable/toggle_track_background"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- ON Text -->
                <TextView
                    android:id="@+id/onText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="30dp"
                    android:text="@string/status_on"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="@font/spoqa_sans_neo_medium"
                    android:textColor="#FFFFFF"
                    android:alpha="0.4"
                    android:letterSpacing="0.1" />

                <!-- OFF Text -->
                <TextView
                    android:id="@+id/offText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="30dp"
                    android:text="@string/status_off"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="@font/spoqa_sans_neo_medium"
                    android:textColor="#000000"
                    android:alpha="0.0"
                    android:letterSpacing="0.1" />

                <!-- Toggle Circle with Icon -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/toggleCircle"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <ImageView
                        android:id="@+id/powerIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_power"
                        android:contentDescription="@string/toggle_description" />

                </androidx.cardview.widget.CardView>

            </FrameLayout>

            <!-- Status Indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Status Dot -->
                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/status_dot_active" />

                <!-- Status Label -->
                <TextView
                    android:id="@+id/statusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/status_active"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="@font/spoqa_sans_neo_medium"
                    android:textColor="#000000"
                    android:alpha="0.5"
                    android:letterSpacing="0.1" />

            </LinearLayout>

        </LinearLayout>
            
        </LinearLayout>
        
        <!-- Divider -->
        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="#000000"
          android:alpha="0.08"
          android:layout_marginStart="24dp"
          android:layout_marginEnd="24dp" />
        
        <!-- Statistics Summary Section -->
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="24dp"
          android:paddingEnd="24dp"
          android:paddingTop="20dp"
          android:paddingBottom="20dp">

            <!-- Section Title -->
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="TODAY"
              android:textSize="16sp"
              android:fontFamily="@font/spoqa_sans_neo_light"
              android:textColor="#000000"
              android:alpha="0.5"
              android:letterSpacing="0.1"
              android:layout_marginBottom="8dp" />

            <!-- 3-Column Grid without cards -->
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:weightSum="3">

                <!-- Shorts Entry -->
                <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:gravity="center"
                  android:paddingTop="8dp"
                  android:paddingBottom="8dp"
                  android:paddingStart="8dp"
                  android:paddingEnd="4dp">

                    <!-- Number -->
                    <TextView
                      android:id="@+id/shortsEntryNumber"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="0"
                      android:textSize="36sp"
                      android:fontFamily="@font/spoqa_sans_neo_bold"
                      android:textColor="@color/primary_dark"
                      android:layout_marginBottom="8dp" />

                    <!-- Label -->
                    <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="@string/stats_entry_count"
                      android:textSize="13sp"
                      android:fontFamily="@font/spoqa_sans_neo_light"
                      android:textColor="#737373"
                      android:gravity="center" />

                </LinearLayout>

                <!-- Vertical Divider -->
                <View
                  android:layout_width="1dp"
                  android:layout_height="match_parent"
                  android:background="#000000"
                  android:alpha="0.08"
                  android:layout_marginTop="8dp"
                  android:layout_marginBottom="8dp" />

                <!-- Shorts Consumption -->
                <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:gravity="center"
                  android:paddingTop="8dp"
                  android:paddingBottom="8dp"
                  android:paddingStart="4dp"
                  android:paddingEnd="4dp">

                    <!-- Number -->
                    <TextView
                      android:id="@+id/shortsConsumptionNumber"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="0"
                      android:textSize="36sp"
                      android:fontFamily="@font/spoqa_sans_neo_bold"
                      android:textColor="@color/primary_dark"
                      android:layout_marginBottom="8dp" />

                    <!-- Label -->
                    <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="@string/stats_consumption_count"
                      android:textSize="13sp"
                      android:fontFamily="@font/spoqa_sans_neo_light"
                      android:textColor="#737373"
                      android:gravity="center" />

                </LinearLayout>

                <!-- Vertical Divider -->
                <View
                  android:layout_width="1dp"
                  android:layout_height="match_parent"
                  android:background="#000000"
                  android:alpha="0.08"
                  android:layout_marginTop="8dp"
                  android:layout_marginBottom="8dp" />

                <!-- Watch Time -->
                <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:gravity="center"
                  android:paddingTop="8dp"
                  android:paddingBottom="8dp"
                  android:paddingStart="4dp"
                  android:paddingEnd="8dp">

                    <!-- Time Text -->
                    <TextView
                      android:id="@+id/watchTimeText"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="0m"
                      android:textSize="36sp"
                      android:fontFamily="@font/spoqa_sans_neo_bold"
                      android:textColor="@color/primary_dark"
                      android:layout_marginBottom="8dp"
                      android:maxLines="1"
                      android:autoSizeTextType="uniform"
                      android:autoSizeMinTextSize="24sp"
                      android:autoSizeMaxTextSize="36sp"
                      android:autoSizeStepGranularity="1sp" />

                    <!-- Label -->
                    <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="@string/stats_watch_time"
                      android:textSize="13sp"
                      android:fontFamily="@font/spoqa_sans_neo_light"
                      android:textColor="#737373"
                      android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000"
            android:alpha="0.08"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" />

        <!-- Target Apps Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="24dp">

            <!-- 차단 대상 텍스트 + 아이콘 리스트 (한 줄) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blocked_apps_title"
                    android:textSize="16sp"
                    android:fontFamily="@font/spoqa_sans_neo_bold"
                    android:textColor="#000000"
                    android:alpha="0.4"
                    android:letterSpacing="0.1"
                    android:layout_marginEnd="12dp"
                    android:textAllCaps="true" />

                <!-- 가로 스크롤 앱 리스트 컨테이너 -->
                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/blockedAppsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

            </LinearLayout>

            <!-- 안내 문구 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/blocked_apps_notice"
                android:textSize="12sp"
                android:fontFamily="@font/spoqa_sans_neo_light"
                android:textColor="#9E9E9E"
                android:alpha="0.7"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- AdMob Banner Ad Container -->
    <FrameLayout
      android:id="@+id/adViewContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="#FFFFFF"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">
        
        <FrameLayout
          android:id="@+id/adView"
          android:layout_width="match_parent"
          android:layout_height="50dp"/>
    
    </FrameLayout>

    <!-- Permission Warning (shown when permissions missing) - Overlay at root level -->
    <LinearLayout
        android:id="@+id/permissionWarning"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/topSection"
        app:layout_constraintBottom_toTopOf="@id/adViewContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Warning Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/permission_warning_icon"
            android:textSize="72sp"
            android:textColor="#FFA726"
            android:alpha="0.9" />

        <!-- Warning Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/permission_warning_title"
            android:textSize="@dimen/text_title"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:textColor="#000000"
            android:letterSpacing="0.01" />

        <!-- Warning Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/permission_warning_message"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/spoqa_sans_neo_light"
            android:textColor="#000000"
            android:alpha="0.6"
            android:textAlignment="center"
            android:lineSpacingExtra="4dp" />

        <!-- Settings Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/permissionSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/permission_setup_button"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:textColor="#FFFFFF"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:letterSpacing="0.02"
            app:backgroundTint="#000000"
            app:elevation="4dp"
            app:rippleColor="#40FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
