<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 제목 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_custom_message_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:textColor="@color/gray_900"
            android:layout_marginBottom="24dp" />

        <!-- 타이머 시작 전 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/custom_message_before_timer_label"
            android:textSize="14sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:textColor="@color/gray_700"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editBeforeTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:hint="@string/custom_message_hint_before"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:maxLength="100"
            android:gravity="top|start"
            android:textSize="15sp"
            android:fontFamily="@font/spoqa_sans_neo_regular"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_400"
            android:padding="12dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:layout_marginBottom="20dp" />

        <!-- 타이머 완료 후 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/custom_message_after_timer_label"
            android:textSize="14sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:textColor="@color/gray_700"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editAfterTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:hint="@string/custom_message_hint_after"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:maxLength="100"
            android:gravity="top|start"
            android:textSize="15sp"
            android:fontFamily="@font/spoqa_sans_neo_regular"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_400"
            android:padding="12dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:layout_marginBottom="16dp" />

        <!-- 초기화 / 완료 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_message_reset"
                android:textSize="14sp"
                android:fontFamily="@font/spoqa_sans_neo_medium"
                android:textColor="@color/gray_500" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- 완료 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/custom_timer_done"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            app:backgroundTint="@color/accent_purple"
            android:textColor="@color/white" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
