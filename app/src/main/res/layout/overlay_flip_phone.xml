<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay design - Consistent with timer screen design -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Native Ad Container (Top) -->
    <FrameLayout
        android:id="@+id/nativeAdContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/nativeAd"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

    </FrameLayout>

    <!-- Main Message -->
    <TextView
        android:id="@+id/mainMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="@string/block_message_before_timer"
        android:textSize="32sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/spoqa_sans_neo_bold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <LinearLayout
        android:id="@+id/taskLockOverlayContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="72dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/brandWatermark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nativeAdContainer">

        <TextView
            android:id="@+id/taskLockOverlayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:gravity="center"
            android:text="@string/task_lock_overlay_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/taskLockOverlaySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/spoqa_sans_neo_light"
            android:gravity="center"
            android:textColor="#8A8A8A"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="36dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/taskLockOverlayList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/taskLockOverlayClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_timer_skip_white_solid"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:gravity="center"
            android:paddingVertical="18dp"
            android:text="@string/task_lock_overlay_close"
            android:textColor="#000000"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/taskLockPostpone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/spoqa_sans_neo_light"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:textColor="#8A8A8A"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Button Container -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toTopOf="@id/brandWatermark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Primary Button -->
        <TextView
            android:id="@+id/startTimerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/block_button_think_again"
            android:textSize="15sp"
            android:textColor="#000000"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/btn_timer_skip_white_solid"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible" />

        <!-- Watch Button (shown after timer) -->
        <TextView
            android:id="@+id/watchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/block_button_yes"
            android:textSize="15sp"
            android:textColor="#000000"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/btn_timer_skip_white_solid"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Secondary Button -->
        <TextView
            android:id="@+id/skipButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/block_button_close"
            android:textSize="15sp"
            android:textColor="#8A8A8A"
            android:fontFamily="@font/spoqa_sans_neo_light"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible" />

        <!-- 바로 보기 (즉시 해제) — 클릭 진입 시 노출, white outline 스타일 (secondary)
             N초 후 활성화 (skipButton과 동일 카운트다운 패턴)
             한도 0 도달 시 클릭하면 다이얼로그(광고/프리미엄/닫기) 노출 -->
        <TextView
            android:id="@+id/instantUnblockButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/instant_unblock_label"
            android:textSize="15sp"
            android:textColor="#CCCCCC"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/btn_timer_outline_white"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

    <!-- AdMob Banner Ad Container -->
    <FrameLayout
        android:id="@+id/adViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
    </FrameLayout>
    
    <!-- Brand Watermark -->
    <TextView
      android:id="@+id/brandWatermark"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="88dp"
      android:text="@string/app_name"
      android:textSize="14sp"
      android:textColor="#4A4A4A"
      android:fontFamily="@font/spoqa_sans_neo_light"
      android:letterSpacing="0.05"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
