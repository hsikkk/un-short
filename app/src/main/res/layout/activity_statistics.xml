<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header - Black Background -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#000000"
        android:padding="32dp"
        android:paddingTop="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF"
            android:alpha="0.7"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/permission_back_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/statistics_title"
            android:textSize="@dimen/text_logo"
            android:fontFamily="@font/spoqa_sans_neo_thin"
            android:textColor="#FFFFFF"
            android:letterSpacing="-0.02"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Content - ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Date Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/datePrevButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_left"
                    android:tint="#000000"
                    android:alpha="0.6"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Previous date" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/dateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2025.01.15"
                        android:textSize="15sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/dateLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/statistics_today"
                        android:textSize="11sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:alpha="0.5"
                        android:letterSpacing="-0.02"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/dateNextButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#000000"
                    android:alpha="0.2"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="Next date" />

            </LinearLayout>

            <!-- Hero Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="36dp"
                android:paddingTop="36dp"
                android:paddingBottom="36dp"
                android:background="#FFFFFF">

                <!-- Main Stats -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/heroContextText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="27번 시도"
                        android:textSize="12sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:alpha="0.5"
                        android:letterSpacing="-0.02"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/heroValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textSize="72sp"
                        android:fontFamily="@font/spoqa_sans_neo_thin"
                        android:textColor="#000000"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/heroLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/statistics_watched"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:alpha="0.5"
                        android:letterSpacing="-0.02"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/gray_200"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="28dp" />

                <!-- Saved Time -->
                <TextView
                    android:id="@+id/heroSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="23개를 건너뛰어\n12분을 아꼈습니다"
                    android:textSize="14sp"
                    android:fontFamily="@font/spoqa_sans_neo_light"
                    android:textColor="#000000"
                    android:alpha="0.6"
                    android:letterSpacing="-0.02"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000"
                android:alpha="0.08"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp" />

            <!-- Detail Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/statistics_detail_title"
                    android:textSize="11sp"
                    android:fontFamily="@font/spoqa_sans_neo_light"
                    android:textColor="#000000"
                    android:alpha="0.5"
                    android:letterSpacing="-0.02"
                    android:layout_marginBottom="16dp" />

                <!-- First Watch Only -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/statistics_first_watch_only"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:alpha="0.6"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/firstWatchOnlyValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:letterSpacing="-0.02" />

                </LinearLayout>

                <!-- Scroll Watch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/statistics_scroll_watch"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:alpha="0.6"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/scrollWatchValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:letterSpacing="-0.02" />

                </LinearLayout>

                <!-- YouTube -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="YouTube"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:alpha="0.6"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/youtubeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:letterSpacing="-0.02" />

                </LinearLayout>

                <!-- Instagram -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Instagram"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:alpha="0.6"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/instagramValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:letterSpacing="-0.02" />

                </LinearLayout>

                <!-- TikTok -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="TikTok"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:alpha="0.6"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/tiktokValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="13sp"
                        android:fontFamily="@font/spoqa_sans_neo_light"
                        android:textColor="#000000"
                        android:letterSpacing="-0.02" />

                </LinearLayout>

                <!-- Insight -->
                <TextView
                    android:id="@+id/insightText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/statistics_insight_good"
                    android:textSize="12sp"
                    android:fontFamily="@font/spoqa_sans_neo_light"
                    android:textColor="#000000"
                    android:alpha="0.5"
                    android:letterSpacing="-0.02"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000"
                android:alpha="0.08"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp" />

            <!-- 7 Days Chart Section -->
            <LinearLayout
                android:id="@+id/chartSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/statistics_recent_7days"
                    android:textSize="11sp"
                    android:fontFamily="@font/spoqa_sans_neo_light"
                    android:textColor="#000000"
                    android:alpha="0.5"
                    android:letterSpacing="-0.02"
                    android:layout_marginBottom="16dp" />

                <!-- Chart will be populated dynamically -->

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
