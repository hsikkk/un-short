<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header (sticky) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <!-- Title -->
        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_dialog_title_simple"
            android:textSize="22sp"
            android:textColor="@color/primary_dark"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:letterSpacing="-0.01"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_300" />

    </LinearLayout>

    <!-- Content (scrollable) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="32dp"
            android:background="@color/gray_50"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="24dp"
                android:paddingHorizontal="16dp">

        <!-- Why Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_why_title"
            android:textSize="16sp"
            android:textColor="@color/gray_900"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_why_content"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:fontFamily="@font/spoqa_sans_neo"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Data Collection Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_data_title"
            android:textSize="16sp"
            android:textColor="@color/gray_900"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:layout_marginBottom="12dp" />

        <!-- Collected Data -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_data_collected"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:fontFamily="@font/spoqa_sans_neo"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="12dp" />

        <!-- Not Collected Data -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_data_not_collected"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:fontFamily="@font/spoqa_sans_neo"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Usage Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_usage_title"
            android:textSize="16sp"
            android:textColor="@color/gray_900"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_usage_content"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:fontFamily="@font/spoqa_sans_neo"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Storage Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_storage_title"
            android:textSize="16sp"
            android:textColor="@color/gray_900"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_storage_content"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:fontFamily="@font/spoqa_sans_neo"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp" />

        <!-- FAQ Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_faq_title"
            android:textSize="16sp"
            android:textColor="@color/gray_900"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_faq_content"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:fontFamily="@font/spoqa_sans_neo"
            android:lineSpacingExtra="6dp" />

        </LinearLayout>

    </ScrollView>

    </FrameLayout>

    <!-- Footer (sticky) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <!-- Top divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_200"
            android:layout_marginBottom="12dp" />

        <!-- Buttons -->
        <Button
            android:id="@+id/btnAgree"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_btn_agree"
            android:textSize="13sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExit"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_btn_exit"
            android:textColor="@color/gray_700"
            android:textSize="13sp"
            android:fontFamily="@font/spoqa_sans_neo_medium"
            android:textAllCaps="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/gray_400"
            app:strokeWidth="1dp" />

    </LinearLayout>

</LinearLayout>
