<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="48dp"
    android:background="#FFFFFF">

    <!-- Content Area (centered vertically) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Main Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_page5_title"
            android:textSize="28sp"
            android:textColor="@color/primary_dark"
            android:fontFamily="@font/spoqa_sans_neo_bold"
            android:textAlignment="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_page5_subtitle"
            android:textSize="16sp"
            android:textColor="@color/gray_600"
            android:fontFamily="@font/spoqa_sans_neo"
            android:textAlignment="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="48dp" />

        <!-- Visual Divider -->
        <View
            android:layout_width="80dp"
            android:layout_height="3dp"
            android:background="@color/accent_purple_light" />

    </LinearLayout>

    <!-- Start Button (bottom) -->
    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_start_button"
        style="@style/Widget.App.Button" />

</LinearLayout>
