    <!-- Device Admin (App Uninstall Protection) -->
    <string name="device_admin_title">앱 삭제 방지</string>
    <string name="device_admin_desc">충동적인 앱 삭제 방지</string>
    <string name="device_admin_explanation">쇼츠를 끊고 싶은데 앱을 지워버린 경험이 있나요?\n\nun:short는 의지가 약해지는 순간을 막아드립니다.</string>
    <string name="device_admin_dialog_title">삭제 방지 기능을 활성화할까요?</string>
    <string name="device_admin_dialog_message">이 기능은 un:short를 삭제하기 전에 추가 단계를 거치게 합니다.\n\n의지가 약해지는 순간에 충동적인 결정을 막아줍니다.\n\n언제든지 설정 → 보안 → 기기 관리 앱에서 비활성화할 수 있습니다.</string>
    <string name="device_admin_dialog_enable">활성화</string>
    <string name="device_admin_dialog_cancel">나중에</string>
    <string name="device_admin_deactivate_title">보호 기능을 비활성화할까요?</string>
    <string name="device_admin_deactivate_message">이 기능을 비활성화하려면:\n\n설정 → 보안 → 기기 관리 앱 → un:short\n\n순서로 이동한 후 [비활성화]를 누르세요</string>
    <string name="device_admin_deactivate_button">설정으로 이동</string>
    <string name="device_admin_receiver_enabled">un:short 앱 삭제 방지 기능이 활성화되었습니다</string>
    <string name="device_admin_receiver_disable_warning">앱 삭제 방지 기능을 비활성화하면 충동적으로 un:short를 삭제할 수 있습니다. 계속하시겠습니까?</string>
    <string name="device_admin_receiver_disabled">un:short 앱 삭제 방지 기능이 비활성화되었습니다</string>

    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">접근성 권한 사용 안내</string>

    <string name="privacy_why_title">왜 접근성 권한이 필요한가요?</string>
    <string name="privacy_why_content">un:short는 숏폼 콘텐츠 감지를 위해 접근성 서비스를 사용합니다.\n\n이는 쇼츠 화면을 자동으로 차단하는 핵심 기능입니다.</string>

    <string name="privacy_data_title">수집하는 데이터</string>
    <string name="privacy_data_collected">✓ 화면 콘텐츠 (쇼츠 감지 목적만)\n✓ 앱 패키지 이름\n✓ 비디오 메타데이터 해시값 (임시)</string>
    <string name="privacy_data_not_collected">✗ 개인 정보 (이름, 연락처 등)\n✗ 시청 기록\n✗ 계정 정보\n✗ 입력 텍스트</string>

    <string name="privacy_usage_title">데이터 사용 방법</string>
    <string name="privacy_usage_content">• 쇼츠 화면 감지에만 사용\n• 서버 전송 없음 (100% 오프라인)\n• 비디오 변경 감지용 해시만 임시 저장\n• 앱 종료 시 자동 삭제</string>

    <string name="privacy_storage_title">데이터 보관 정책</string>
    <string name="privacy_storage_content">• 세션 ID만 기기 내 임시 저장\n• 앱/서비스 재시작 시 즉시 삭제\n• 제3자 공유 절대 없음</string>

    <string name="privacy_faq_title">자주 묻는 질문</string>
    <string name="privacy_faq_content">Q: 내 시청 기록이 저장되나요?\nA: 아니요. 해시값만 임시 저장됩니다.\n\nQ: 제3자와 데이터를 공유하나요?\nA: 아니요. 완전 오프라인입니다.\n\nQ: 권한을 나중에 취소할 수 있나요?\nA: 네. 설정에서 언제든 비활성화 가능합니다.</string>

