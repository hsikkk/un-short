    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">O que acessamos</string>

    <string name="privacy_why_title">Por que a permissão de acessibilidade é necessária?</string>
    <string name="privacy_why_content">un:short usa o serviço de acessibilidade para detectar conteúdo de vídeo curto.\n\nEsta é a função principal para bloquear automaticamente shorts quando detectados.</string>

    <string name="privacy_data_title">Dados que coletamos</string>
    <string name="privacy_data_collected">✓ Conteúdo da tela (apenas para detecção de shorts)\n✓ Nomes de pacotes de apps\n✓ Hash de metadados de vídeo (temporário)</string>
    <string name="privacy_data_not_collected">✗ Informações pessoais (nome, contatos, etc.)\n✗ Histórico de visualização\n✗ Informações de conta\n✗ Entrada de texto</string>

    <string name="privacy_usage_title">Como os dados são usados</string>
    <string name="privacy_usage_content">• Usado apenas para detecção de tela de shorts\n• Sem transmissão para servidor (100% offline)\n• Apenas hashes temporários para detecção de mudança de vídeo\n• Deletado automaticamente quando o app fecha</string>

    <string name="privacy_storage_title">Política de armazenamento de dados</string>
    <string name="privacy_storage_content">• Apenas IDs de sessão armazenados temporariamente no dispositivo\n• Imediatamente deletados quando app/serviço reinicia\n• Nunca compartilhados com terceiros</string>

    <string name="privacy_faq_title">Perguntas frequentes</string>
    <string name="privacy_faq_content">P: Meu histórico de visualização é salvo?\nR: Não. Apenas valores hash são armazenados temporariamente.\n\nP: Vocês compartilham dados com terceiros?\nR: Não. Operação completamente offline.\n\nP: Posso revogar a permissão depois?\nR: Sim. Você pode desativá-la nas configurações a qualquer momento.</string>

    <string name="privacy_btn_agree">Concordar &amp; Ir para configurações</string>
    <string name="privacy_btn_exit">Sair do app</string>
    <string name="privacy_btn_disagree">Discordar</string>

