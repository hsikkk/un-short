    <string name="device_admin_dialog_cancel">Şimdi değil</string>
    <string name="device_admin_deactivate_title">Korumayı devre dışı bırak?</string>
    <string name="device_admin_deactivate_message">Bu özelliği devre dışı bırakmak için şuraya gidin:\n\nAyarlar → Güvenlik → Cihaz yöneticisi uygulamaları → un:short\n\nSonra [Devre dışı bırak]\'a dokunun</string>
    <string name="device_admin_deactivate_button">Ayarlara git</string>
    <string name="device_admin_receiver_enabled">un:short uygulama silme koruması etkinleştirildi</string>
    <string name="device_admin_receiver_disable_warning">Silme korumasını devre dışı bırakmak, un:short\'un dürtüsel kaldırılmasına izin verir. Devam et?</string>
