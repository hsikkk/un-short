    <!-- Device Admin (App Uninstall Protection) -->
    <string name="device_admin_title">ऐप हटाने की सुरक्षा</string>
    <string name="device_admin_desc">आवेगपूर्ण ऐप अनइंस्टॉलेशन को रोकें</string>
    <string name="device_admin_explanation">कभी कमज़ोरी के क्षण में ऐप को हटा दिया?\n\nun:short आपके संकल्प के डगमगाने पर आवेगपूर्ण अनइंस्टॉलेशन को रोकता है।</string>
    <string name="device_admin_dialog_title">हटाने की सुरक्षा सक्षम करें?</string>
    <string name="device_admin_dialog_message">यह सुविधा un:short को अनइंस्टॉल करने से पहले एक अतिरिक्त चरण जोड़ती है।\n\nयह कमज़ोरी के क्षणों में आवेगपूर्ण निर्णयों से बचने में मदद करती है।\n\nआप इसे किसी भी समय सेटिंग्स → सुरक्षा → डिवाइस व्यवस्थापक ऐप्स में निष्क्रिय कर सकते हैं।</string>
    <string name="device_admin_dialog_enable">सक्षम करें</string>
    <string name="device_admin_dialog_cancel">अभी नहीं</string>
    <string name="device_admin_deactivate_title">सुरक्षा निष्क्रिय करें?</string>
    <string name="device_admin_deactivate_message">इस सुविधा को अक्षम करने के लिए, यहाँ जाएं:\n\nसेटिंग्स → सुरक्षा → डिवाइस व्यवस्थापक ऐप्स → un:short\n\nफिर [निष्क्रिय करें] टैप करें</string>
    <string name="device_admin_deactivate_button">सेटिंग्स में जाएं</string>
    <string name="device_admin_receiver_enabled">un:short ऐप हटाने की सुरक्षा सक्षम की गई</string>
    <string name="device_admin_receiver_disable_warning">हटाने की सुरक्षा को अक्षम करने से un:short का आवेगपूर्ण अनइंस्टॉलेशन हो सकता है। जारी रखें?</string>
    <string name="device_admin_receiver_disabled">un:short ऐप हटाने की सुरक्षा अक्षम की गई</string>

    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">हम क्या एक्सेस करते हैं</string>

    <string name="privacy_why_title">पहुंच अनुमति क्यों आवश्यक है?</string>
    <string name="privacy_why_content">un:short छोटे वीडियो कंटेंट का पता लगाने के लिए पहुंच सेवा का उपयोग करता है।\n\nयह पता लगाने पर Shorts को स्वचालित रूप से ब्लॉक करने का मुख्य कार्य है।</string>

    <string name="privacy_data_title">हम क्या डेटा एकत्र करते हैं</string>
    <string name="privacy_data_collected">✓ स्क्रीन कंटेंट (केवल Shorts पहचान के लिए)\n✓ ऐप पैकेज नाम\n✓ वीडियो मेटाडेटा हैश (अस्थायी)</string>
    <string name="privacy_data_not_collected">✗ व्यक्तिगत जानकारी (नाम, संपर्क, आदि)\n✗ देखने का इतिहास\n✗ खाता जानकारी\n✗ टेक्स्ट इनपुट</string>

    <string name="privacy_usage_title">डेटा का उपयोग कैसे किया जाता है</string>
    <string name="privacy_usage_content">• केवल Shorts स्क्रीन पहचान के लिए उपयोग किया जाता है\n• कोई सर्वर ट्रांसमिशन नहीं (100% ऑफलाइन)\n• केवल वीडियो परिवर्तन पहचान के लिए अस्थायी हैश\n• ऐप बंद होने पर स्वचालित रूप से हटाया जाता है</string>

    <string name="privacy_storage_title">डेटा संग्रहण नीति</string>
    <string name="privacy_storage_content">• केवल सत्र ID डिवाइस पर अस्थायी रूप से संग्रहीत\n• ऐप/सेवा पुनः शुरू होने पर तुरंत हटाया जाता है\n• कभी भी तीसरे पक्ष के साथ साझा नहीं किया जाता</string>

    <string name="privacy_faq_title">अक्सर पूछे जाने वाले प्रश्न</string>
    <string name="privacy_faq_content">प्र: क्या मेरा देखने का इतिहास सहेजा जाता है?\nउ: नहीं। केवल हैश मान अस्थायी रूप से संग्रहीत होते हैं।\n\nप्र: क्या आप डेटा तीसरे पक्ष के साथ साझा करते हैं?\nउ: नहीं। पूरी तरह से ऑफलाइन संचालन।\n\nप्र: क्या मैं बाद में अनुमति रद्द कर सकता हूँ?\nउ: हाँ। आप इसे किसी भी समय सेटिंग्स में अक्षम कर सकते हैं।</string>

    <string name="privacy_btn_agree">सहमत हूँ और सेटिंग्स में जाएं</string>
    <string name="privacy_btn_exit">ऐप से बाहर निकलें</string>
