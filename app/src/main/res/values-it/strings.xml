    <!-- Device Admin (App Uninstall Protection) -->
    <string name="device_admin_title">Protezione dalla cancellazione dell\'app</string>
    <string name="device_admin_desc">Previeni disinstallazione impulsiva dell\'app</string>
    <string name="device_admin_explanation">Hai mai cancellato l\'app in un momento di debolezza?\n\nun:short previene la disinstallazione impulsiva quando la tua determinazione vacilla.</string>
    <string name="device_admin_dialog_title">Abilitare la protezione dalla cancellazione?</string>
    <string name="device_admin_dialog_message">Questa funzione aggiunge un passaggio extra prima di disinstallare un:short.\n\nTi aiuta a resistere a decisioni impulsive durante momenti di debolezza.\n\nPuoi disattivarla in qualsiasi momento in Impostazioni → Sicurezza → App di amministrazione del dispositivo.</string>
    <string name="device_admin_dialog_enable">Abilita</string>
    <string name="device_admin_dialog_cancel">Non ora</string>
    <string name="device_admin_deactivate_title">Disattivare la protezione?</string>
    <string name="device_admin_deactivate_message">Per disattivare questa funzione, vai a:\n\nImpostazioni → Sicurezza → App di amministrazione del dispositivo → un:short\n\nPoi tocca [Disattiva]</string>
    <string name="device_admin_deactivate_button">Vai alle impostazioni</string>
    <string name="device_admin_receiver_enabled">Protezione dalla cancellazione dell\'app un:short abilitata</string>
    <string name="device_admin_receiver_disable_warning">Disabilitare la protezione dalla cancellazione consente la disinstallazione impulsiva di un:short. Continuare?</string>
    <string name="device_admin_receiver_disabled">Protezione dalla cancellazione dell\'app un:short disabilitata</string>

    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">A cosa accediamo</string>

    <string name="privacy_why_title">Perché è necessaria l\'autorizzazione di accessibilità?</string>
    <string name="privacy_why_content">un:short utilizza il servizio di accessibilità per rilevare contenuti video brevi.\n\nQuesta è la funzione principale per bloccare automaticamente gli shorts quando vengono rilevati.</string>

    <string name="privacy_data_title">Dati che raccogliamo</string>
    <string name="privacy_data_collected">✓ Contenuto dello schermo (solo per il rilevamento degli shorts)\n✓ Nomi dei pacchetti delle app\n✓ Hash dei metadati video (temporaneo)</string>
    <string name="privacy_data_not_collected">✗ Informazioni personali (nome, contatti, ecc.)\n✗ Cronologia di visualizzazione\n✗ Informazioni account\n✗ Input di testo</string>

    <string name="privacy_usage_title">Come vengono utilizzati i dati</string>
    <string name="privacy_usage_content">• Utilizzato solo per il rilevamento della schermata degli shorts\n• Nessuna trasmissione al server (100% offline)\n• Solo hash temporanei per il rilevamento delle modifiche ai video\n• Eliminazione automatica alla chiusura dell\'app</string>

    <string name="privacy_storage_title">Politica di archiviazione dei dati</string>
    <string name="privacy_storage_content">• Solo gli ID di sessione vengono archiviati temporaneamente sul dispositivo\n• Eliminati immediatamente al riavvio dell\'app/servizio\n• Mai condivisi con terze parti</string>

    <string name="privacy_faq_title">Domande frequenti</string>
    <string name="privacy_faq_content">D: La mia cronologia di visualizzazione viene salvata?\nR: No. Vengono memorizzati temporaneamente solo valori hash.\n\nD: Condividete i dati con terze parti?\nR: No. Funzionamento completamente offline.\n\nD: Posso revocare l\'autorizzazione in seguito?\nR: Sì. Puoi disattivarla nelle impostazioni in qualsiasi momento.</string>

    <string name="privacy_btn_agree">Accetta &amp; Vai alle impostazioni</string>
    <string name="privacy_btn_exit">Esci dall\'app</string>
    <string name="privacy_btn_disagree">Rifiuta</string>

