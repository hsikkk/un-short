    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">我们访问的内容</string>

    <string name="privacy_why_title">为什么需要辅助功能权限?</string>
    <string name="privacy_why_content">un:short使用辅助功能服务检测短视频内容。\n\n这是检测到短视频时自动屏蔽的核心功能。</string>

    <string name="privacy_data_title">我们收集的数据</string>
    <string name="privacy_data_collected">✓ 屏幕内容(仅用于短视频检测)\n✓ 应用包名\n✓ 视频元数据哈希(临时)</string>
    <string name="privacy_data_not_collected">✗ 个人信息(姓名、联系人等)\n✗ 观看历史\n✗ 账户信息\n✗ 文本输入</string>

    <string name="privacy_usage_title">数据使用方式</string>
    <string name="privacy_usage_content">• 仅用于短视频屏幕检测\n• 不传输到服务器(100%离线)\n• 仅用于视频更改检测的临时哈希\n• 应用关闭时自动删除</string>

    <string name="privacy_storage_title">数据存储策略</string>
    <string name="privacy_storage_content">• 仅在设备上临时存储会话ID\n• 应用/服务重启时立即删除\n• 绝不与第三方共享</string>

    <string name="privacy_faq_title">常见问题</string>
    <string name="privacy_faq_content">问:是否保存观看历史?\n答:否。仅临时存储哈希值。\n\n问:是否与第三方共享数据?\n答:否。完全离线运行。\n\n问:以后可以撤销权限吗?\n答:可以。你可以随时在设置中禁用。</string>

