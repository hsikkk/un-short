    <string name="device_admin_deactivate_button">Zu Einstellungen gehen</string>
    <string name="device_admin_receiver_enabled">un:short App-Löschschutz aktiviert</string>
    <string name="device_admin_receiver_disable_warning">Das Deaktivieren des Löschschutzes ermöglicht die impulsive Deinstallation von un:short. Fortfahren?</string>
    <string name="device_admin_receiver_disabled">un:short App-Löschschutz deaktiviert</string>

    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">Worauf wir zugreifen</string>

    <string name="privacy_why_title">Warum wird die Zugriffshilfe-Berechtigung benötigt?</string>
    <string name="privacy_why_content">un:short verwendet den Zugriffshilfe-Dienst, um Kurzvideos zu erkennen.\n\nDies ist die Kernfunktion, um Shorts automatisch zu blockieren, wenn sie erkannt werden.</string>

    <string name="privacy_data_title">Daten, die wir sammeln</string>
    <string name="privacy_data_collected">✓ Bildschirminhalt (nur zur Shorts-Erkennung)\n✓ App-Paketnamen\n✓ Video-Metadaten-Hash (temporär)</string>
    <string name="privacy_data_not_collected">✗ Persönliche Informationen (Name, Kontakte usw.)\n✗ Wiedergabeverlauf\n✗ Kontoinformationen\n✗ Texteingaben</string>

    <string name="privacy_usage_title">Wie Daten verwendet werden</string>
    <string name="privacy_usage_content">• Nur zur Erkennung des Shorts-Bildschirms verwendet\n• Keine Serverübertragung (100 % offline)\n• Nur temporäre Hashes zur Videoänderungserkennung\n• Automatisches Löschen beim App-Schließen</string>

    <string name="privacy_storage_title">Datenspeicherungsrichtlinie</string>
    <string name="privacy_storage_content">• Nur Sitzungs-IDs werden temporär auf dem Gerät gespeichert\n• Sofort gelöscht beim Neustart der App/des Dienstes\n• Niemals mit Dritten geteilt</string>

    <string name="privacy_faq_title">Häufig gestellte Fragen</string>
    <string name="privacy_faq_content">F: Wird mein Wiedergabeverlauf gespeichert?\nA: Nein. Nur Hash-Werte werden temporär gespeichert.\n\nF: Teilen Sie Daten mit Dritten?\nA: Nein. Vollständig offline betrieben.\n\nF: Kann ich die Berechtigung später widerrufen?\nA: Ja. Sie können sie jederzeit in den Einstellungen deaktivieren.</string>

    <string name="privacy_btn_agree">Zustimmen &amp; Zu Einstellungen gehen</string>
    <string name="privacy_btn_exit">App beenden</string>
    <string name="privacy_btn_disagree">Ablehnen</string>

