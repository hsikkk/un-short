    <!-- Privacy Consent Dialog -->
    <string name="privacy_dialog_title_simple">Apa Yang Kami Akses</string>

    <string name="privacy_why_title">Mengapa izin aksesibilitas diperlukan?</string>
    <string name="privacy_why_content">un:short menggunakan layanan aksesibilitas untuk mendeteksi konten video pendek.\n\nIni adalah fungsi inti untuk secara otomatis memblokir shorts saat terdeteksi.</string>

    <string name="privacy_data_title">Data Yang Kami Kumpulkan</string>
    <string name="privacy_data_collected">✓ Konten layar (hanya untuk deteksi shorts)\n✓ Nama paket aplikasi\n✓ Hash metadata video (sementara)</string>
    <string name="privacy_data_not_collected">✗ Informasi pribadi (nama, kontak, dll.)\n✗ Riwayat tontonan\n✗ Informasi akun\n✗ Input teks</string>

    <string name="privacy_usage_title">Bagaimana Data Digunakan</string>
    <string name="privacy_usage_content">• Digunakan hanya untuk deteksi layar shorts\n• Tidak dikirim ke server (100% offline)\n• Hanya hash sementara untuk deteksi perubahan video\n• Otomatis dihapus saat aplikasi ditutup</string>

    <string name="privacy_storage_title">Kebijakan Penyimpanan Data</string>
    <string name="privacy_storage_content">• Hanya ID sesi yang disimpan sementara di perangkat\n• Segera dihapus saat aplikasi/layanan dimulai ulang\n• Tidak pernah dibagikan dengan pihak ketiga</string>

    <string name="privacy_faq_title">Pertanyaan Yang Sering Diajukan</string>
    <string name="privacy_faq_content">T: Apakah riwayat tontonan saya disimpan?\nJ: Tidak. Hanya nilai hash yang disimpan sementara.\n\nT: Apakah Anda membagikan data dengan pihak ketiga?\nJ: Tidak. Sepenuhnya beroperasi offline.\n\nT: Bisakah saya mencabut izin nanti?\nJ: Ya. Anda dapat menonaktifkannya di pengaturan kapan saja.</string>

    <string name="privacy_btn_agree">Setuju &amp; Buka Pengaturan</string>
