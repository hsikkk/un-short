@Composable
fun {FEATURE_NAME_PASCAL}Route(
    goBack: () -> Unit,
    // Add additional navigation callbacks here
) {
    val viewModel: {FEATURE_NAME_PASCAL}ViewModel = hiltViewModel()

    val uiState by viewModel.container.stateFlow.collectAsStateWithLifecycle()

    var isFirstView by rememberSaveable { mutableStateOf(true) }

    LaunchedEffect(Unit) {
        if (isFirstView) {
            viewModel.onIntent({FEATURE_NAME_PASCAL}Intent.Initialize)
            isFirstView = false
        }
    }

    viewModel.collectSideEffect {
        when (it) {
            {FEATURE_NAME_PASCAL}SideEffect.GoBack -> goBack()
            // Handle other side effects
        }
    }

    {FEATURE_NAME_PASCAL}Screen(
        uiState = uiState,
        goBack = { viewModel.onIntent({FEATURE_NAME_PASCAL}Intent.GoBack) },
        // Add other intent handlers
    )
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun {FEATURE_NAME_PASCAL}Screen(
    uiState: {FEATURE_NAME_PASCAL}State,
    goBack: () -> Unit,
    // Add other event handlers
) {
    BackHandler {
        goBack()
    }

    Scaffold(
        topBar = { AppBar() }
    ) {
        Box(
            modifier = Modifier
                .padding(it)
                .fillMaxSize(),
        ) {
            when (uiState) {
                {FEATURE_NAME_PASCAL}State.Loading -> {
                    // Loading state UI
                }
                is {FEATURE_NAME_PASCAL}State.Success -> {
                    // Success state UI
                }
                is {FEATURE_NAME_PASCAL}State.Error -> {
                    // Error state UI
                }
            }
        }
    }
}

